{
  "name": "n8n-nodes-nace",
  "version": "0.1.0",
  "description": "Evaluate, classify, score, and route content with Drex by Nace",
  "license": "MIT",
  "homepage": "https://github.com/nace-ai/n8n-nodes-nace",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "nace",
    "drex",
    "classification",
    "routing"
  ],
  "author": {
    "name": "Nace",
    "email": "support@nace.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nace-ai/n8n-nodes-nace.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/NaceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Nace/Nace.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
