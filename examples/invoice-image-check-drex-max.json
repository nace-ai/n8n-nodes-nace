{
  "name": "Check a synthetic invoice image with Drex Max",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "synthetic-invoice",
      "name": "Synthetic invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{source:'Synthetic invoice fixture'},binary:{invoice:{data:'',mimeType:'image/png',fileName:'synthetic-invoice.png'}}}];"
      }
    },
    {
      "id": "check-invoice",
      "name": "Check invoice",
      "type": "n8n-nodes-nace.nace",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "evaluate",
        "model": "drex-max",
        "stateFormat": "text",
        "stateText": "Inspect Image 1, a synthetic invoice.",
        "imageProperties": "invoice",
        "questionsMode": "json",
        "questionsJson": "{\"invoice\": {\"type\": \"noul\", \"instructions\": \"Does Image 1 show an invoice with a readable total?\", \"criteria\": {\"true\": \"Invoice with readable total\", \"false\": \"Missing invoice or total\"}}, \"total\": {\"type\": \"choice\", \"instructions\": \"What is the total in Image 1?\", \"criteria\": {\"USD 120.00\": null, \"Other or unreadable\": null}}}",
        "options": {
          "includeOtherFields": true
        }
      },
      "credentials": {
        "naceApi": {
          "name": "Nace API"
        }
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Synthetic invoice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Synthetic invoice": {
      "main": [
        [
          {
            "node": "Check invoice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
